{
  "root": "page",
  "elements": {
    "nav": {
      "type": "NavBar",
      "props": {
        "brand": "Marisela",
        "links": [
          {
            "label": "Discografía",
            "href": "#discografia"
          },
          {
            "label": "Canciones",
            "href": "#canciones"
          },
          {
            "label": "Gira",
            "href": "#gira"
          },
          {
            "label": "Biografía",
            "href": "#biografia"
          },
          {
            "label": "Videos",
            "href": "#videos"
          },
          {
            "label": "Prensa",
            "href": "#prensa"
          }
        ],
        "cta": {
          "label": "Escuchar",
          "href": "https://open.spotify.com/artist/73c2MjCAFNyKYIs7nBlqG2"
        },
        "socials": {
          "$state": "/socialLinks"
        }
      },
      "children": []
    },
    "hero": {
      "type": "Hero",
      "props": {
        "anchorId": "inicio",
        "image": {
          "$state": "/images/hero"
        },
        "stats": {
          "$state": "/stats/items"
        },
        "variant": "floating-card",
        "title": "Marisela Beltrán",
        "eyebrow": "Ganadora de Todos Quieren Fama",
        "subtitle": "Cantante mazatleca e imitadora profesional, ganadora del reality show Todos quieren fama.",
        "tagline": "— Desde 1999",
        "primaryCta": {
          "label": "Escuchar",
          "href": "#canciones"
        },
        "secondaryCta": {
          "label": "Próximos conciertos",
          "href": "#gira"
        },
        "showScrollIndicator": true
      },
      "children": []
    },
    "top-songs": {
      "type": "TopSongs",
      "props": {
        "anchorId": "canciones",
        "songs": {
          "$state": "/topSongs"
        },
        "variant": "playlist",
        "title": "Lo más escuchado",
        "eyebrow": "Favoritas",
        "limit": 10,
        "showStats": true
      },
      "children": []
    },
    "tour-dates": {
      "type": "TourDates",
      "props": {
        "anchorId": "gira",
        "events": {
          "$state": "/tourDates"
        },
        "ticketsUrl": {
          "$state": "/tour/ticketsUrl"
        },
        "variant": "glass-rows",
        "title": "Próximos conciertos",
        "eyebrow": "En vivo",
        "emptyTitle": "Nuevas fechas muy pronto",
        "emptyMessage": "Estamos preparando los próximos encuentros. Déjanos tu correo y te avisamos.",
        "ctaLabel": "Boletos"
      },
      "children": []
    },
    "discography": {
      "type": "Discography",
      "props": {
        "anchorId": "discografia",
        "albums": {
          "$state": "/discography"
        },
        "title": "Universo musical",
        "eyebrow": "Discografía",
        "layout": "grid",
        "showTypes": true
      },
      "children": []
    },
    "video": {
      "type": "VideoGallery",
      "props": {
        "anchorId": "videos",
        "videos": {
          "$state": "/videos"
        },
        "title": "Videos",
        "eyebrow": "Mira",
        "limit": 6
      },
      "children": []
    },
    "biography": {
      "type": "Biography",
      "props": {
        "anchorId": "biografia",
        "paragraphs": {
          "$state": "/biography/paragraphs"
        },
        "facts": {
          "$state": "/biography/facts"
        },
        "image": {
          "$state": "/images/portrait"
        },
        "sourceNote": {
          "$state": "/biography/sourceNote"
        },
        "title": "Su historia",
        "eyebrow": "Biografía",
        "lead": "Marisela Beltrán es una joven cantante mazatleca que comienza a ver los resultados de su esfuerzo y dedicación para ganarse un lugar en la música; el 27 de febrero ganó el reality show de TV Azteca, Todos quieren fama.",
        "maxParagraphs": 3
      },
      "children": []
    },
    "press-quotes": {
      "type": "PressQuotes",
      "props": {
        "anchorId": "prensa",
        "quotes": {
          "$state": "/pressQuotes"
        },
        "variant": "glass-cards",
        "title": "Voces",
        "eyebrow": "Prensa",
        "limit": 6
      },
      "children": []
    },
    "merch": {
      "type": "FeatureSection",
      "props": {
        "anchorId": "tienda",
        "featureType": "merch",
        "title": "Tienda",
        "eyebrow": "Extra",
        "body": "Artículos oficiales y novedades, directamente desde los canales de la artista.",
        "items": [],
        "cta": {
          "label": "Explorar",
          "href": "https://www.marisela.com.mx"
        }
      },
      "children": []
    },
    "social-links": {
      "type": "SocialLinks",
      "props": {
        "anchorId": "redes",
        "links": {
          "$state": "/socialLinks"
        },
        "title": "Conecta",
        "eyebrow": "Redes"
      },
      "children": []
    },
    "newsletter": {
      "type": "Newsletter",
      "props": {
        "anchorId": "boletin",
        "title": "Mantente cerca",
        "eyebrow": "Boletín",
        "body": "Recibe noticias, lanzamientos y fechas antes que nadie.",
        "placeholder": "tu@correo.com",
        "buttonLabel": "Unirme",
        "successMessage": "¡Bienvenido! Pronto tendrás noticias.",
        "errorMessage": "Revisa tu correo, por favor.",
        "privacyNote": "Solo lo importante. Nunca spam."
      },
      "children": []
    },
    "footer": {
      "type": "Footer",
      "props": {
        "brand": "Marisela Beltrán",
        "tagline": "— Desde 1999",
        "links": [
          {
            "label": "Discografía",
            "href": "#discografia"
          },
          {
            "label": "Canciones",
            "href": "#canciones"
          },
          {
            "label": "Gira",
            "href": "#gira"
          },
          {
            "label": "Biografía",
            "href": "#biografia"
          },
          {
            "label": "Videos",
            "href": "#videos"
          },
          {
            "label": "Prensa",
            "href": "#prensa"
          }
        ],
        "socials": {
          "$state": "/socialLinks"
        },
        "sources": {
          "$state": "/credits/sources"
        },
        "copyright": "© 2026 Marisela",
        "credits": [
          "Texto basado en el sitio oficial y testimonios de la artista.",
          "Foto, desarrollo y producción visual por Bernardo Mondragón https://bernardomondragon.net",
          "Portadas de álbumes © sus respectivos titulares."
        ]
      },
      "children": []
    },
    "page": {
      "type": "Page",
      "props": {
        "title": "Marisela Beltrán — Desde 1999",
        "description": "Marisela Beltrán es una joven cantante mazatleca que comienza a ver los resultados de su esfuerzo y dedicación para ganarse un lugar en la música; el 27 de febrero ganó el reality show de TV Azteca, Todos quieren fama.",
        "lang": "es"
      },
      "children": [
        "nav",
        "hero",
        "top-songs",
        "tour-dates",
        "discography",
        "video",
        "biography",
        "press-quotes",
        "merch",
        "social-links",
        "newsletter",
        "footer"
      ]
    }
  }
}
