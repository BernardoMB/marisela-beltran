{
  "root": "page",
  "elements": {
    "nav": {
      "type": "NavBar",
      "props": {
        "brand": "Marisela Beltrán",
        "links": [
          {
            "label": "Biografía",
            "href": "#biografia"
          },
          {
            "label": "Música",
            "href": "#discografia"
          },
          {
            "label": "Gira",
            "href": "#gira"
          },
          {
            "label": "Videos",
            "href": "#videos"
          },
          {
            "label": "Prensa",
            "href": "#prensa"
          },
          {
            "label": "Contacto",
            "href": "#contacto"
          }
        ],
        "cta": {
          "label": "Boletín",
          "href": "#boletin"
        },
        "socials": {
          "$state": "/socialLinks"
        }
      },
      "children": []
    },
    "hero": {
      "type": "Hero",
      "props": {
        "anchorId": "inicio",
        "variant": "centered",
        "title": "Marisela Beltrán",
        "tagline": {
          "$state": "/tagline"
        },
        "primaryCta": {
          "label": "Biografía",
          "href": "#biografia"
        },
        "secondaryCta": {
          "label": "Música",
          "href": "#discografia"
        },
        "stats": {
          "$state": "/stats/items"
        }
      },
      "children": []
    },
    "divider-1": {
      "type": "SectionDivider",
      "props": {
        "variant": "hairline"
      },
      "children": []
    },
    "biography": {
      "type": "Biography",
      "props": {
        "anchorId": "biografia",
        "title": "Biografía",
        "eyebrow": "01",
        "paragraphs": {
          "$state": "/biography/paragraphs"
        },
        "facts": {
          "$state": "/biography/facts"
        },
        "sourceNote": {
          "$state": "/biography/sourceNote"
        }
      },
      "children": []
    },
    "discography": {
      "type": "Discography",
      "props": {
        "anchorId": "discografia",
        "title": "Música",
        "eyebrow": "02",
        "albums": {
          "$state": "/discography"
        },
        "layout": "grid",
        "limit": 12
      },
      "children": []
    },
    "top-songs": {
      "type": "TopSongs",
      "props": {
        "anchorId": "canciones",
        "variant": "numbered",
        "title": "Canciones",
        "eyebrow": "03",
        "songs": {
          "$state": "/topSongs"
        },
        "limit": 10
      },
      "children": []
    },
    "tour-dates": {
      "type": "TourDates",
      "props": {
        "anchorId": "gira",
        "variant": "table",
        "title": "Gira",
        "eyebrow": "04",
        "events": {
          "$state": "/tourDates"
        },
        "emptyTitle": "Próximamente",
        "emptyMessage": "Nuevas fechas próximamente.",
        "ctaLabel": "Ver fechas"
      },
      "children": []
    },
    "divider-2": {
      "type": "SectionDivider",
      "props": {
        "variant": "hairline"
      },
      "children": []
    },
    "video": {
      "type": "VideoGallery",
      "props": {
        "anchorId": "videos",
        "title": "Videos",
        "eyebrow": "07",
        "videos": {
          "$state": "/videos"
        },
        "limit": 9
      },
      "children": []
    },
    "press-quotes": {
      "type": "PressQuotes",
      "props": {
        "anchorId": "prensa",
        "variant": "columns",
        "title": "Prensa",
        "eyebrow": "09",
        "quotes": {
          "$state": "/pressQuotes"
        },
        "limit": 6
      },
      "children": []
    },
    "divider-3": {
      "type": "SectionDivider",
      "props": {
        "variant": "hairline"
      },
      "children": []
    },
    "newsletter": {
      "type": "Newsletter",
      "props": {
        "anchorId": "boletin",
        "title": "Boletín",
        "eyebrow": "10",
        "body": "Recibe noticias y fechas de presentaciones.",
        "placeholder": "tu@email.com",
        "buttonLabel": "Suscribirme →",
        "successMessage": "Gracias por suscribirte.",
        "errorMessage": "Por favor verifica tu email.",
        "privacyNote": "Nunca compartimos tu información."
      },
      "children": []
    },
    "social-links": {
      "type": "SocialLinks",
      "props": {
        "anchorId": "redes",
        "title": "Redes",
        "eyebrow": "12",
        "links": {
          "$state": "/socialLinks"
        }
      },
      "children": []
    },
    "contact": {
      "type": "ContactBooking",
      "props": {
        "anchorId": "contacto",
        "title": "Contacto",
        "eyebrow": "11",
        "body": "Para presentaciones y colaboraciones."
      },
      "children": []
    },
    "merch": {
      "type": "FeatureSection",
      "props": {
        "anchorId": "tienda",
        "featureType": "merch",
        "title": "Tienda",
        "eyebrow": "10",
        "body": "Próximamente."
      },
      "children": []
    },
    "footer": {
      "type": "Footer",
      "props": {
        "brand": "Marisela Beltrán",
        "tagline": {
          "$state": "/tagline"
        },
        "links": [
          {
            "label": "Biografía",
            "href": "#biografia"
          },
          {
            "label": "Música",
            "href": "#discografia"
          },
          {
            "label": "Contacto",
            "href": "#contacto"
          }
        ],
        "socials": {
          "$state": "/socialLinks"
        },
        "copyright": "© 2026 Marisela Beltrán",
        "credits": [
          "Texto basado en Noroeste — Marisela Beltrán, la sinaloense que comienza a triunfar en la música."
        ],
        "sources": {
          "$state": "/credits/sources"
        }
      },
      "children": []
    },
    "page": {
      "type": "Page",
      "props": {
        "title": "Marisela Beltrán — Ganadora de Todos Quieren Fama",
        "description": "Marisela Beltrán es una joven cantante mazatleca que comienza a ver los resultados de su esfuerzo y dedicación para ganarse un lugar en la música.",
        "lang": "es"
      },
      "children": [
        "nav",
        "hero",
        "divider-1",
        "biography",
        "discography",
        "top-songs",
        "tour-dates",
        "divider-2",
        "video",
        "press-quotes",
        "divider-3",
        "newsletter",
        "social-links",
        "contact",
        "merch",
        "footer"
      ]
    }
  }
}
