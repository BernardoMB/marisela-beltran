{
  "root": "page",
  "elements": {
    "nav": {
      "type": "NavBar",
      "props": {
        "brand": "Marisela Beltrán",
        "links": [
          {
            "label": "INICIO",
            "href": "#inicio"
          },
          {
            "label": "BIO",
            "href": "#biografia"
          },
          {
            "label": "DISCOS",
            "href": "#discografia"
          },
          {
            "label": "CANCIONES",
            "href": "#canciones"
          },
          {
            "label": "GIRA",
            "href": "#gira"
          },
          {
            "label": "CONTACTO",
            "href": "#contacto"
          }
        ],
        "socials": {
          "$state": "/socialLinks"
        }
      },
      "children": []
    },
    "hero": {
      "type": "Hero",
      "props": {
        "anchorId": "inicio",
        "variant": "index",
        "title": "Marisela Beltrán",
        "subtitle": {
          "$state": "/tagline"
        },
        "tagline": "ARCHIVO DEL SISTEMA / ARTISTA.DAT",
        "stats": {
          "$state": "/stats/items"
        },
        "primaryCta": {
          "label": "[ESCUCHAR]",
          "href": "#canciones"
        },
        "secondaryCta": {
          "label": "[BIOGRAFÍA]",
          "href": "#biografia"
        }
      },
      "children": []
    },
    "divider-1": {
      "type": "SectionDivider",
      "props": {
        "variant": "ascii",
        "label": "MARISELA BELTRÁN"
      },
      "children": []
    },
    "biography": {
      "type": "Biography",
      "props": {
        "anchorId": "biografia",
        "title": "BIOGRAFÍA",
        "eyebrow": "BIO.TXT",
        "paragraphs": {
          "$state": "/biography/paragraphs"
        },
        "facts": {
          "$state": "/biography/facts"
        },
        "sourceNote": {
          "$state": "/biography/sourceNote"
        }
      },
      "children": []
    },
    "divider-2": {
      "type": "SectionDivider",
      "props": {
        "variant": "ascii",
        "label": "DISCOGRAFÍA"
      },
      "children": []
    },
    "discography": {
      "type": "Discography",
      "props": {
        "anchorId": "discografia",
        "title": "DISCOGRAFÍA",
        "eyebrow": "DISCOS.LST",
        "intro": "Catálogo de grabaciones y producciones.",
        "albums": {
          "$state": "/discography"
        },
        "layout": "list",
        "showTypes": true
      },
      "children": []
    },
    "top-songs": {
      "type": "TopSongs",
      "props": {
        "anchorId": "canciones",
        "variant": "table",
        "title": "CANCIONES DESTACADAS",
        "eyebrow": "TRACKS.DAT",
        "songs": {
          "$state": "/topSongs"
        },
        "showStats": true
      },
      "children": []
    },
    "tour-dates": {
      "type": "TourDates",
      "props": {
        "anchorId": "gira",
        "variant": "table",
        "title": "FECHAS DE GIRA",
        "eyebrow": "FECHAS.TXT",
        "intro": "Próximas presentaciones en vivo.",
        "events": {
          "$state": "/tourDates"
        },
        "emptyTitle": "NO HAY FECHAS PROGRAMADAS",
        "emptyMessage": "Actualmente no hay presentaciones confirmadas. Regresa pronto para actualizaciones o suscríbete al boletín para recibir notificaciones.",
        "ctaLabel": "[SUSCRIBIR AL BOLETÍN]"
      },
      "children": []
    },
    "divider-3": {
      "type": "SectionDivider",
      "props": {
        "variant": "ascii",
        "label": "MULTIMEDIA"
      },
      "children": []
    },
    "video": {
      "type": "VideoGallery",
      "props": {
        "anchorId": "videos",
        "title": "VIDEOS",
        "eyebrow": "VIDEO.DIR",
        "intro": "Videoclips oficiales y material audiovisual.",
        "videos": {
          "$state": "/videos"
        }
      },
      "children": []
    },
    "press-quotes": {
      "type": "PressQuotes",
      "props": {
        "anchorId": "prensa",
        "variant": "markdown",
        "title": "CITAS DE PRENSA",
        "eyebrow": "CITAS.MD",
        "quotes": {
          "$state": "/pressQuotes"
        }
      },
      "children": []
    },
    "newsletter": {
      "type": "Newsletter",
      "props": {
        "anchorId": "boletin",
        "title": "BOLETÍN",
        "eyebrow": "SUSCRIBIR.SH",
        "body": "Recibe actualizaciones sobre nuevos lanzamientos, presentaciones y noticias exclusivas.",
        "placeholder": "$ email --address",
        "buttonLabel": "[ENVIAR]",
        "successMessage": "✓ SUSCRIPCIÓN CONFIRMADA",
        "errorMessage": "✗ ERROR: INTENTA DE NUEVO",
        "privacyNote": "Tu información se maneja con confidencialidad. No spam."
      },
      "children": []
    },
    "social-links": {
      "type": "SocialLinks",
      "props": {
        "anchorId": "redes",
        "title": "REDES SOCIALES",
        "eyebrow": "SOCIAL.CFG",
        "intro": "Conecta en plataformas digitales.",
        "links": {
          "$state": "/socialLinks"
        }
      },
      "children": []
    },
    "contact": {
      "type": "ContactBooking",
      "props": {
        "anchorId": "contacto",
        "title": "CONTACTO / CONTRATACIONES",
        "eyebrow": "CONTACT.INI",
        "body": "Para contrataciones, entrevistas y colaboraciones."
      },
      "children": []
    },
    "merch": {
      "type": "FeatureSection",
      "props": {
        "anchorId": "tienda",
        "featureType": "merch",
        "title": "TIENDA",
        "eyebrow": "MERCH.LST",
        "body": "Productos oficiales y artículos de colección.",
        "cta": {
          "label": "[VER TIENDA]",
          "href": "#tienda",
          "external": false
        }
      },
      "children": []
    },
    "footer": {
      "type": "Footer",
      "props": {
        "brand": "Marisela Beltrán",
        "tagline": "GANADORA DE TODOS QUIEREN FAMA",
        "links": [
          {
            "label": "INICIO",
            "href": "#inicio"
          },
          {
            "label": "BIOGRAFÍA",
            "href": "#biografia"
          },
          {
            "label": "DISCOGRAFÍA",
            "href": "#discografia"
          },
          {
            "label": "CONTACTO",
            "href": "#contacto"
          }
        ],
        "socials": {
          "$state": "/socialLinks"
        },
        "copyright": "© 2026 MARISELA BELTRÁN. TODOS LOS DERECHOS RESERVADOS.",
        "credits": [
          "Texto basado en Noroeste — Marisela Beltrán, la sinaloense que comienza a triunfar en la música."
        ],
        "sources": {
          "$state": "/credits/sources"
        }
      },
      "children": []
    },
    "page": {
      "type": "Page",
      "props": {
        "title": "Marisela Beltrán — Ganadora de Todos Quieren Fama",
        "description": "Marisela Beltrán es una joven cantante mazatleca que comienza a ver los resultados de su esfuerzo y dedicación para ganarse un lugar en la música.",
        "lang": "es"
      },
      "children": [
        "nav",
        "hero",
        "divider-1",
        "biography",
        "divider-2",
        "discography",
        "top-songs",
        "tour-dates",
        "divider-3",
        "video",
        "press-quotes",
        "newsletter",
        "social-links",
        "contact",
        "merch",
        "footer"
      ]
    }
  }
}
