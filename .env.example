# Copy this file to `.env` and fill in the keys you have.
# Every key is OPTIONAL — the pipeline degrades gracefully without them,
# but each one unlocks a smarter stage.

# Claude (Anthropic) — json-render UI spec generation (one unique layout per
# design brief) and grounded biography / press-quote synthesis.
# Without it, a deterministic spec builder is used instead.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — passed through to Clooney-Agent forks that analyze UI with OpenAI.
OPENAI_API_KEY=sk-...

# Google Gemini — required by Clooney-Agent (s4sachin/agent-clooney uses
# Gemini vision to inventory each inspirational site's components).
GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------

# Override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Ticketmaster Discovery API key — enables real tour-date lookup.
# TICKETMASTER_API_KEY=

# Bandsintown app id — alternative tour-date source.
# BANDSINTOWN_APP_ID=

# site-facelift AI review (runs `claude -p` with facelift's validation prompt
# for every generated site). auto = on when the `claude` CLI is installed.
# FACELIFT_AI_REVIEW=auto      # auto | on | off
# FACELIFT_AI_CLEANUP=off      # on = also run facelift's cleanup prompt (edits files)

# Clooney-Agent repository override (comma-separated list, tried in order).
# CLOONEY_REPO_URLS=https://github.com/saksham-shr/Clooney-Agent.git,https://github.com/s4sachin/agent-clooney.git
